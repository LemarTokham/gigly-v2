{
  "name": "gigly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @gigly/web dev",
    "build": "pnpm --filter @gigly/web build",
    "start": "pnpm --filter @gigly/web start",
    "lint": "pnpm --filter @gigly/web lint && apps/web/node_modules/.bin/eslint",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "node --test \"tests/**/*.test.mts\" \"apps/*/tests/**/*.test.mts\" \"packages/*/tests/**/*.test.mts\"",
    "db:start": "sh scripts/supabase.sh start",
    "db:stop": "sh scripts/supabase.sh stop",
    "db:status": "sh scripts/supabase.sh status",
    "db:reset": "sh scripts/supabase.sh db reset",
    "db:types": "sh scripts/supabase.sh gen types typescript --local > packages/shared/src/database.types.ts",
    "db:push": "sh scripts/supabase.sh db push",
    "seed:hypes": "node --env-file=apps/web/.env.local scripts/seed-hypes.mjs",
    "make:admin": "node --env-file=apps/web/.env.local scripts/make-admin.mjs",
    "venues:locate": "node --env-file=apps/web/.env.local scripts/locate-venues.mjs",
    "dev:lan": "node scripts/use-lan.mjs && pnpm --filter @gigly/web dev -H 0.0.0.0",
    "import": "node --env-file=apps/web/.env.local scripts/import/run.mjs",
    "db:clear-demo": "node --env-file=apps/web/.env.local scripts/clear-demo.mjs",
    "venues:skiddle": "node --env-file=apps/web/.env.local scripts/venues-skiddle.mjs",
    "venues:load": "node --env-file=apps/web/.env.local scripts/load-venues.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^20",
    "supabase": "^2.117.0",
    "typescript": "^5"
  }
}
